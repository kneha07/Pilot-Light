AWS_REGION=us-east-2
SONIC_REGION=us-east-1
AWS_PROFILE=pilotlight

# Box
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_RUNBOOKS_FOLDER_ID=
BOX_INCIDENTS_FOLDER_ID=
BOX_REVIEWER_LOGIN=you@example.com

# Bedrock
SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
TEXT_MODEL_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
ONCALL_PHONE=+1XXXXXXXXXX
PAGE_PHONE=+1XXXXXXXXXX

# Voice server (ngrok URL, no trailing slash). Leave empty to skip the call.
VOICE_SERVER_URL=

# Dashboard login (uvicorn dashboard.app:app --port 8001)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=

# App
FAIL_MODE_PARAM=/pilotlight/checkout/fail_mode
CHECKOUT_LOG_GROUP=/pilotlight/checkout
ALARM_NAME=pilotlight-checkout-5xx

# Code-level spoken confirm gate on remediation. Never disable in production.
REQUIRE_SPOKEN_CONFIRM=true

# Auto-fix plan after each postmortem (Box AI + Nova 2 Lite). PR mode is manual: python -m pilotlight.auto_fix <INCIDENT_ID> --pr
AUTO_FIX_ENABLED=true

# Open a GitHub PR (config/flags.json + incident record) after every approved fix. Uses the gh CLI login.
AUTO_REVERT_PR=true
REVERT_PR_REPO=kneha07/Pilot-Light

# Shared secret for the dashboard's Break something button (set the same value in Vercel)
DEMO_TRIGGER_TOKEN=
