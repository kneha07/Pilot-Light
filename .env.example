AWS_REGION=us-east-2
SONIC_REGION=us-east-1
AWS_PROFILE=pilotlight

# Box
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_RUNBOOKS_FOLDER_ID=
BOX_INCIDENTS_FOLDER_ID=
BOX_REVIEWER_LOGIN=you@example.com

# Bedrock
SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
TEXT_MODEL_ID=

# Amazon Connect (see connect/SETUP.md). Leave CONNECT_CONTACT_FLOW_ID empty to skip the call.
CONNECT_INSTANCE_ID=
CONNECT_INSTANCE_URL=https://<alias>.my.connect.aws
CONNECT_CONTACT_FLOW_ID=
CONNECT_SOURCE_PHONE=+1XXXXXXXXXX
CONNECT_QUEUE_ID=
ONCALL_PHONE=+1XXXXXXXXXX
PAGE_PHONE=+1XXXXXXXXXX
# Code-level check that the caller said "confirm" before a fix. Set false only as an emergency demo fallback.
REQUIRE_SPOKEN_CONFIRM=true

# Dashboard login (uvicorn dashboard.app:app --port 8001)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=

# App
FAIL_MODE_PARAM=/pilotlight/checkout/fail_mode
CHECKOUT_LOG_GROUP=/pilotlight/checkout
ALARM_NAME=pilotlight-checkout-5xx
